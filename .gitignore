# Whitelist mode: ignore everything, then allow explicitly
*

# ── Git config ──
!.gitignore

# ── Root documentation ──
!README.md
!LICENSE
!CHANGELOG.md
!SECURITY.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md

# ── Go CI ──
!.golangci.yml
!.github/
!.github/**

# ── Build ──
!Makefile

# ── Go source ──
!go.mod
!go.sum
!internal/
!internal/**
# Runtime state under any package (created by tests running with the
# package as cwd) stays out of the repo.
**/.opencraft/
**/.opencraft/**
!pkg/
!pkg/**
!tools/
!tools/**

# ── Wails desktop app ──
!main.go
!execd_main.go
!mac_window_*.go
!execd_umask_*.go
!execd_watch_*.go
!wails.json
!frontend/
!frontend/**
# Node dependencies stay out of the repo; npm install reproduces them.
frontend/node_modules/
frontend/node_modules/**
# Built frontend assets are regenerated by wails build; keep them out of git.
frontend/dist/
frontend/dist/**
frontend/package.json.md5
# Wails-generated TS bindings (frontend/wailsjs) are regenerated by
# `wails generate module` / `wails dev` / `wails build`; keep them out
# of git and generate them in CI.
frontend/wailsjs/
frontend/wailsjs/**
# Frontend plugins ship in the repo as reference implementations.
!plugins/
!plugins/hello/
!plugins/hello/**
!build/
!build/**
# Homebrew cask and maintenance scripts live in the repo too.
!Casks/
!Casks/**
!scripts/
!scripts/**
# Generated app bundles stay out of the repo; wails build reproduces them.
build/bin/
build/bin/**
# Wails regenerates the NSIS installer sources and the WebView2
# bootstrapper on every -nsis build; keep them out of git.
build/windows/installer/
build/windows/installer/**

# macOS junk stays out of the repo (whitelist mode: re-ignore after the
# !build/** negation above).
**/.DS_Store
