# Whitelist mode: ignore everything, then allow explicitly
*

# ── Git config ──
!.gitignore

# ── Root documentation ──
!README.md
!LICENSE
!CHANGELOG.md
!SECURITY.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md

# ── Go CI ──
!.golangci.yml
!.github/
!.github/**

# ── Build ──
!Makefile

# ── Go source ──
!go.mod
!go.sum
!internal/
!internal/**
!pkg/
!pkg/**
!tools/
!tools/**

# ── Wails desktop app ──
!main.go
!execd_main.go
!wails.json
!frontend/
!frontend/**
# Node dependencies stay out of the repo; npm install reproduces them.
frontend/node_modules/
frontend/node_modules/**
!build/
!build/**
# Generated app bundles stay out of the repo; wails build reproduces them.
build/bin/
build/bin/**
