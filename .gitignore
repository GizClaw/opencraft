# Whitelist mode: ignore everything, then allow explicitly
*

# ── Git config ──
!.gitignore

# ── Root documentation ──
!README.md
!LICENSE
!CHANGELOG.md
!SECURITY.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md

# ── Go CI ──
!.golangci.yml
!.github/
!.github/**

# ── Build ──
!Makefile

# ── Go source ──
!go.mod
!go.sum
!internal/
!internal/**
!pkg/
!pkg/**
!tools/
!tools/**

# ── Wails desktop app ──
!main.go
!execd_main.go
!mac_window_*.go
!execd_umask_*.go
!execd_watch_*.go
!wails.json
!frontend/
!frontend/**
# Frontend plugins ship in the repo as reference implementations.
!plugins/
!plugins/hello/
!plugins/hello/**
!build/
!build/**
# Homebrew cask and maintenance scripts live in the repo too.
!Casks/
!Casks/**
!scripts/
!scripts/**

# macOS junk stays out of the repo (whitelist mode: re-ignore after the
# !build/** negation above).
**/.DS_Store
