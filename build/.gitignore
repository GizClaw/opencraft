# Generated app bundles stay out of the repo; wails3 tasks reproduce them.
bin/
bin/**
# wails3 update build-assets generates mobile scaffolding and NSIS helper
# sources; they are not part of the desktop repo and are regenerated on demand.
ios/
# Icons/assets are regenerated by the wails3 generate icons task.
darwin/icons.icns
darwin/Assets.car
# Wails regenerates the NSIS installer sources and the WebView2
# bootstrapper on every -nsis build; keep them out of git.
windows/installer/
windows/installer/**
windows/nsis/MicrosoftEdgeWebview2Setup.exe
linux/desktop/
