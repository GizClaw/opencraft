# Node dependencies stay out of the repo; npm install reproduces them.
node_modules/
node_modules/**
# Built frontend assets are regenerated by wails3 tasks; keep them out of git.
dist/
dist/**
package.json.md5
# Wails v3 generated TS bindings are regenerated by wails3 generate bindings.
bindings/
bindings/**
# TypeScript project-reference (tsc -b) emits these next to the config.
*.tsbuildinfo
vite.config.js
vite.config.d.ts
# Playwright artifacts (reports and per-run snapshots).
test-results/
test-results/**
playwright-report/
playwright-report/**
