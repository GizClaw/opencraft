# Node dependencies stay out of the repo; npm install reproduces them.
node_modules/
node_modules/**
# Built frontend assets are regenerated by wails build; keep them out of git.
dist/
dist/**
package.json.md5
# Wails-generated TS bindings (frontend/wailsjs) are regenerated by
# `wails generate module` / `wails dev` / `wails build`; keep them out
# of git and generate them in CI.
wailsjs/
wailsjs/**
# Playwright artifacts (reports and per-run snapshots).
test-results/
test-results/**
playwright-report/
playwright-report/**
